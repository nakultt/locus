# Normalize to LF in the repository; check out native on Windows.
* text=auto

# Always LF — these run in Linux containers or are read by tooling that
# chokes on CRLF.
*.py    text eol=lf
*.sh    text eol=lf
Procfile text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf

# Binary
*.png binary
*.jpg binary
*.svg text
*.ico binary
