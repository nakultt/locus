# =========================================
# Locus Backend Environment Example
# =========================================

# Core
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/locus
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-fernet-key
FRONTEND_URL=http://localhost:5173

# LLM provider toggle
# - gemini: requires GOOGLE_API_KEY (or per-user key from Settings)
# - ollama: uses local Ollama server and does not require Gemini keys
LLM_PROVIDER=gemini

# Gemini settings
GOOGLE_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-pro

# Local Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen3.5:4b
OLLAMA_SMART_MODEL=qwen3.5:4b
OLLAMA_DISABLE_THINKING=true

# MCP runtime safety controls
MCP_TOOL_LOAD_TIMEOUT_SECONDS=20
MCP_GRAPH_TIMEOUT_SECONDS=120
MCP_STREAM_TIMEOUT_SECONDS=180
MCP_MAX_ACTIONS=80
MCP_MAX_TOOL_RESULT_CHARS=6000
MCP_SSE_RESULT_PREVIEW_CHARS=500

# =========================================
# OAuth providers used to connect integrations
# =========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8000/auth/linear/callback

# =========================================
# MCP server configuration
# Supported transport values: http, sse, stdio
# For stdio, set *_COMMAND (and optional *_ARGS)
# For http/sse, set *_URL and optional *_HEADERS_JSON
# =========================================

# GitHub (official)
MCP_GITHUB_TRANSPORT=http
MCP_GITHUB_URL=https://api.githubcopilot.com/mcp
MCP_GITHUB_HEADERS_JSON=

# Slack (official)
MCP_SLACK_TRANSPORT=http
MCP_SLACK_URL=https://mcp.slack.com/mcp
MCP_SLACK_HEADERS_JSON=

# Linear (official)
MCP_LINEAR_TRANSPORT=http
MCP_LINEAR_URL=https://mcp.linear.app/mcp
MCP_LINEAR_HEADERS_JSON=

# Atlassian Rovo MCP (for Jira/Confluence/Compass)
MCP_ATLASSIAN_TRANSPORT=http
MCP_ATLASSIAN_URL=https://mcp.atlassian.com/v1/mcp
MCP_ATLASSIAN_HEADERS_JSON=

# Notion (official)
MCP_NOTION_TRANSPORT=http
MCP_NOTION_URL=https://mcp.notion.com/mcp
MCP_NOTION_HEADERS_JSON=

# Google Workspace MCP (set your chosen provider endpoint)
MCP_GOOGLE_WORKSPACE_TRANSPORT=http
MCP_GOOGLE_WORKSPACE_URL=
MCP_GOOGLE_WORKSPACE_HEADERS_JSON=

# Bugasura MCP (set your chosen provider endpoint)
MCP_BUGASURA_TRANSPORT=http
MCP_BUGASURA_URL=
MCP_BUGASURA_HEADERS_JSON=
