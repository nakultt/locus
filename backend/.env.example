# Copy to .env and fill in. Never commit the real file.

# ============== Required ==============

# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=

# Fernet key encrypting every stored integration credential.
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# This must never change once set. Rotating or losing it makes every stored
# credential permanently undecryptable.
ENCRYPTION_KEY=

# ============== Database ==============

# Postgres in production; omit for a local SQLite file.
DATABASE_URL=postgresql://user:password@localhost:5432/locus

# ============== Local model server ==============

# MoE Model Manager, or any OpenAI-compatible endpoint.
# Must be reachable from the backend process -- a remotely hosted backend
# cannot reach a loopback address on your workstation.
MOE_BASE_URL=http://127.0.0.1:8081/v1
MOE_FAST_MODEL=gemma-4-26b-a4b
MOE_SMART_MODEL=qwen3.6-35b-a3b
MOE_API_KEY=local

# Local generation is slow; agent loops chain several calls.
MOE_TIMEOUT_SECONDS=600

# ============== Frontend ==============

FRONTEND_URL=http://localhost:5173

# ============== PR Context Agent ==============

# Public origin GitHub POSTs webhooks to. Locally this is a tunnel URL, since
# GitHub cannot reach localhost:
#   cloudflared tunnel --url http://localhost:8000
# Only used to build the payload URL shown after registering a repo.
PUBLIC_BASE_URL=http://localhost:8000

# Slack Events API signing secret, from the app's Basic Information page.
# Required for QA reply handling: testers reply in the notification thread and
# Locus reopens the ticket if the reply reports a failure.
SLACK_SIGNING_SECRET=

# ============== OAuth (optional, per integration) ==============

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8000/auth/linear/callback

# ============== Autonomous authoring ==============

# The driver that writes code. Unset resolves to "none" and the Autonomous
# dial is inert -- every handed-over ticket comes straight back to you.
LOCUS_AUTHORING_DRIVER=opencode

# How OpenCode is invoked. {prompt} and {workspace} are substituted.
LOCUS_OPENCODE_CMD=opencode run --prompt-file {prompt} --cwd {workspace}

# Pin OpenCode's model for reproducibility. Unset uses OpenCode's default.
# This model is REMOTE. Unlike the analysis models, the brief leaves the
# machine on tickets a human explicitly handed over.
LOCUS_OPENCODE_MODEL=

# full | ticket_only. ticket_only drops the Slack transcript from the brief,
# for teams that cannot send internal discussion to a third party.
LOCUS_AUTHORING_CONTEXT=full

# Wall-clock per attempt.
LOCUS_AUTHORING_TIMEOUT_SECONDS=1200

# Diff caps. Exceeding either refuses the run and spends an attempt.
LOCUS_MAX_CHANGED_FILES=25
LOCUS_MAX_CHANGED_LINES=600

# Ceiling on open Locus-authored pull requests.
LOCUS_MAX_OPEN_AUTONOMOUS_PRS=3

# Commit identity for authored commits.
LOCUS_AGENT_NAME=Locus
LOCUS_AGENT_EMAIL=locus-agent@users.noreply.github.com

# ============== Source and workspace ==============
# Two different settings. Conflating them is how the agent edits Locus itself.

# SOURCE -- a folder holding your repos, e.g. /home/you/code. Found here, the
# agent cuts a git worktree that shares the object store; not found, it clones
# fresh on every attempt and spends the timeout on network.
#
# Must NOT be a directory containing Locus's own tree: that directory holds
# this .env and ENCRYPTION_KEY, which must never change. check_not_locus
# refuses it by name. Per-repo source_path overrides this.
LOCUS_CODE_ROOT=

# WORKSPACE -- where the agent writes. Always isolated from the source.
# Defaults to <tempdir>/locus-workspaces.
LOCUS_WORKSPACE_ROOT=

# Worktrees from failed runs are kept for debugging, swept after this long.
LOCUS_WORKSPACE_TTL_DAYS=3

# Work in the source checkout instead of a worktree. Off by default, and it
# should stay off: the agent then shares a working tree with a human and
# `git checkout` becomes destructive.
LOCUS_ALLOW_IN_PLACE=0

# ============== Calendar agent ==============

LOCUS_CALENDAR_SWEEP_MINUTES=30
LOCUS_CALENDAR_LOOKAHEAD_DAYS=14

# ============== CORS ==============

# Any localhost port is allowed by regex. Set only for a deployed frontend.
CORS_ORIGINS=
