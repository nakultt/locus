{
  "name": "locus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:frontend": "bun --cwd frontend run dev",
    "dev:backend": "cd backend && uv run uvicorn main:app --reload",
    "build": "bun --cwd frontend run build",
    "lint": "bun --cwd frontend run lint",
    "typecheck": "bun --cwd frontend run typecheck",
    "test:backend": "cd backend && uv run pytest tests/ -q",
    "lint:backend": "cd backend && uv run ruff check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.11"
  },
  "packageManager": "bun@1.3.11"
}
